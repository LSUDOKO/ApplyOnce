# ApplyOnce — all optional. Personal data NEVER goes in here; it lives in data/profiles/.

# Log verbosity: debug | info | warn | error
APPLYONCE_LOG_LEVEL=info

# Set to "json" for structured one-line-per-event logs (default is pretty, colourised)
# APPLYONCE_LOG_FORMAT=json

# Point at a specific webcmd binary (defaults to `webcmd` on PATH)
# APPLYONCE_WEBCMD_BIN=/usr/local/bin/webcmd

# Per-command timeout for adapter execution, in milliseconds
# APPLYONCE_WEBCMD_TIMEOUT=180000

# Port for the local demo portal (fixtures/portal/server.mjs)
# APPLYONCE_FIXTURE_PORT=4173
