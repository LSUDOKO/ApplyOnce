{
  "name": "applyonce",
  "version": "0.0.0-development",
  "description": "A self-learning MCP agent that fills student scholarship, internship and job applications from one stored profile \u2014 and never submits without human approval.",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "applyonce-mcp": "dist/mcp/server.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "files": [
    "dist/",
    "schemas/",
    "plugins/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/mcp/server.ts",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "adapters:install": "webcmd plugin install ./plugins/applyonce",
    "adapters:list": "webcmd list -f json",
    "doctor": "webcmd doctor",
    "prepare": "node -e \"process.exit(0)\"",
    "start:remote": "node dist/remote/server.js",
    "dev:remote": "tsx src/remote/server.ts"
  },
  "keywords": [
    "mcp",
    "webcmd",
    "automation",
    "scholarship",
    "internship",
    "students",
    "india",
    "browser-automation",
    "self-healing"
  ],
  "author": "LSUDOKO",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LSUDOKO/ApplyOnce.git"
  },
  "bugs": {
    "url": "https://github.com/LSUDOKO/ApplyOnce/issues"
  },
  "homepage": "https://github.com/LSUDOKO/ApplyOnce#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@agentrhq/webcmd": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "@agentrhq/webcmd": {
      "optional": false
    }
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "ip-address": ">=10.3.1",
    "tar": ">=7.5.21",
    "picomatch": ">=4.0.4",
    "undici": ">=6.28.0",
    "conventional-changelog-writer": ">=9.1.0"
  }
}